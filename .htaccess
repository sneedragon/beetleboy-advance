# Always revalidate the page itself so new app.js/data.js versions load right away
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^((index|world)\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# remilia.sevensevenseven.net opens straight into the world
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^remilia\. [NC]
  RewriteRule ^$ world.html [L]
</IfModule>

AddType application/manifest+json .webmanifest

# Notes, scripts and dot-folders never get served, even if one slips into a deploy
<FilesMatch "\.(md|sh|py|bak|log|sqlite|db)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(git|claude)(/|$)
