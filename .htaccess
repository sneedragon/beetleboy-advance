# Always revalidate the page itself so new app.js/data.js versions load right away
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>


AddType application/manifest+json .webmanifest

# Notes, scripts and dot-folders never get served, even if one slips into a deploy
<FilesMatch "\.(md|sh|py|bak|log|sqlite|db)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(git|claude)(/|$)
